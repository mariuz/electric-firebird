{
  // Build configuration for the published package.
  //
  // Separate from tsconfig.json so the tests stay visible to the type checker
  // while staying out of the published tarball.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "tsBuildInfoFile": "dist/.tsbuildinfo.build"
  },
  "exclude": ["node_modules", "dist", "src/**/__tests__/**"]
}
