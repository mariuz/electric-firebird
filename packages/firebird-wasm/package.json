{
  "name": "firebird-wasm",
  "version": "0.8.0",
  "description": "Firebird embedded database in WebAssembly — runs in the browser and Node, like PGlite for PostgreSQL",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "browser": "dist/browser/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./browser/worker-entry": {
      "types": "./dist/browser/worker-entry.d.ts",
      "default": "./dist/browser/worker-entry.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./repl": {
      "types": "./dist/repl/index.d.ts",
      "default": "./dist/repl/index.js"
    },
    "./electric": {
      "types": "./dist/electric/index.d.ts",
      "default": "./dist/electric/index.js"
    },
    "./electric-server": {
      "types": "./dist/electric-server/index.d.ts",
      "default": "./dist/electric-server/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:wasm": "bash wasm/build.sh",
    "test": "jest --forceExit",
    "bench": "node bench/decode-bench.js",
    "bench:calls": "node bench/call-cost.js",
    "size": "node scripts/size-budget.mjs",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "node scripts/check-publish.mjs"
  },
  "keywords": [
    "firebird",
    "wasm",
    "embedded",
    "database",
    "sql",
    "indexeddb",
    "browser"
  ],
  "author": "mariuz",
  "license": "Apache-2.0",
  "dependencies": {
    "node-firebird-driver": "^3.5.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3",
    "@electric-sql/client": ">=1.5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@electric-sql/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/client": "^1.5.28",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-jest": "^29.2.2",
    "typescript": "^5.5.3",
    "vue": "^3.5.22"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/src/**/*.test.ts",
      "**/src/**/__tests__/**/*.test.ts"
    ],
    "testTimeout": 30000,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/src/browser/"
    ]
  },
  "homepage": "https://mariuz.github.io/electric-firebird/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariuz/electric-firebird.git",
    "directory": "packages/firebird-wasm"
  },
  "bugs": {
    "url": "https://github.com/mariuz/electric-firebird/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "optionalDependencies": {
    "node-firebird-driver-native": "^3.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
