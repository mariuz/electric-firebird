{
  "name": "firebird-wasm",
  "version": "0.16.0",
  "description": "Firebird embedded database in WebAssembly — runs in the browser and Node, like PGlite for PostgreSQL",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "browser": "dist/browser/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./browser/worker-entry": {
      "types": "./dist/browser/worker-entry.d.ts",
      "default": "./dist/browser/worker-entry.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "default": "./dist/svelte/index.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "default": "./dist/solid/index.js"
    },
    "./tanstack": {
      "types": "./dist/tanstack/index.d.ts",
      "default": "./dist/tanstack/index.js"
    },
    "./rxdb": {
      "types": "./dist/rxdb/index.d.ts",
      "default": "./dist/rxdb/index.js"
    },
    "./repl": {
      "types": "./dist/repl/index.d.ts",
      "default": "./dist/repl/index.js"
    },
    "./electric": {
      "types": "./dist/electric/index.d.ts",
      "default": "./dist/electric/index.js"
    },
    "./electric-server": {
      "types": "./dist/electric-server/index.d.ts",
      "default": "./dist/electric-server/index.js"
    },
    "./kysely": {
      "types": "./dist/kysely/index.d.ts",
      "default": "./dist/kysely/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle/index.d.ts",
      "default": "./dist/drizzle/index.js"
    },
    "./vector": {
      "types": "./dist/vector/index.d.ts",
      "default": "./dist/vector/index.js"
    },
    "./fts": {
      "types": "./dist/fts/index.d.ts",
      "default": "./dist/fts/index.js"
    },
    "./replication": {
      "types": "./dist/replication/index.d.ts",
      "default": "./dist/replication/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:wasm": "bash wasm/build.sh",
    "test": "vitest run",
    "bench": "node bench/decode-bench.js",
    "bench:calls": "node bench/call-cost.js",
    "size": "node scripts/size-budget.mjs",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "node scripts/check-publish.mjs"
  },
  "keywords": [
    "firebird",
    "wasm",
    "embedded",
    "database",
    "sql",
    "indexeddb",
    "browser"
  ],
  "author": "mariuz",
  "license": "Apache-2.0",
  "dependencies": {
    "node-firebird-driver": "^3.5.0"
  },
  "peerDependencies": {
    "@electric-sql/client": ">=1.5",
    "@tanstack/db": ">=0.1",
    "@tanstack/query-core": ">=5.0",
    "drizzle-orm": ">=0.30",
    "kysely": ">=0.27",
    "react": ">=18",
    "rxdb": ">=15.0",
    "solid-js": ">=1.7",
    "svelte": ">=4.0.0 || >=5.0.0",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "@tanstack/query-core": {
      "optional": true
    },
    "@tanstack/db": {
      "optional": true
    },
    "rxdb": {
      "optional": true
    },
    "@electric-sql/client": {
      "optional": true
    },
    "kysely": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/client": "^1.5.28",
    "@types/node": "^20.14.10",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "drizzle-orm": "^0.45.4",
    "eslint": "^8.57.0",
    "kysely": "^0.28.14",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.5.3",
    "vitest": "^3.2.7",
    "vue": "^3.5.22"
  },
  "homepage": "https://mariuz.github.io/electric-firebird/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariuz/electric-firebird.git",
    "directory": "packages/firebird-wasm"
  },
  "bugs": {
    "url": "https://github.com/mariuz/electric-firebird/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "optionalDependencies": {
    "node-firebird-driver-native": "^3.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
