From: electric-firebird
Subject: [PATCH] unicode_util: use statically linked ICU under Emscripten

Emscripten links ICU statically via -sUSE_ICU=1, so there is no shared
module to dlopen and no dlsym to bind against.  Under __EMSCRIPTEN__ the
ICU and ConversionICU function tables are therefore populated directly
with the real ICU symbols, and the module-cache machinery (ICUModules,
convIcuMutex) is compiled out because nothing can load or unload a module.

Regenerated against Firebird master; the previous revision of this patch
had malformed hunk headers and never applied.
---

One ICU function needs a wrapper rather than a direct assignment.
ucol_getContractionsAndExpansions returns void while Firebird's function table
declares int32_t.  A cast bridges that on a native build, where the caller
ignores a return register nobody reads; WebAssembly includes the return type in
a function's type and type-checks every indirect call, so the cast aborts with
"null function or function signature mismatch" the first time a UNICODE
collation is opened.

diff --git a/src/common/unicode_util.cpp b/src/common/unicode_util.cpp
index 05ffe21..1626cf2 100644
--- a/src/common/unicode_util.cpp
+++ b/src/common/unicode_util.cpp
@@ -480,11 +480,16 @@ private:
 	AutoPtr<ModuleLoader::Module> inModule;
 };
 
+#ifdef __EMSCRIPTEN__
+static UnicodeUtil::ConversionICU* convIcu = nullptr;
+#else
 static ImplementConversionICU* convIcu = NULL;
 static GlobalPtr<Mutex> convIcuMutex;
+#endif // __EMSCRIPTEN__
 
 
 // cache ICU module instances to not load and unload many times
+#ifndef __EMSCRIPTEN__
 class UnicodeUtil::ICUModules
 {
 	typedef GenericMap<Pair<Left<string, ICU*> > > ModulesMap;
@@ -507,9 +512,13 @@ public:
 };
 
 
+#endif // !__EMSCRIPTEN__
+
 static const char* const COLL_30_VERSION = "41.128.4.4";	// ICU 3.0 collator version
 
+#ifndef __EMSCRIPTEN__
 static GlobalPtr<UnicodeUtil::ICUModules> icuModules;
+#endif // !__EMSCRIPTEN__
 
 
 static void getVersions(const string& configInfo, ObjectsArray<string>& versions)
@@ -1138,6 +1147,83 @@ void UnicodeUtil::utf8Normalize(UCharBuffer& data)
 	}
 }
 
+#ifdef __EMSCRIPTEN__
+// Emscripten/WASM: ICU is linked statically via -sUSE_ICU=1, so the function
+// pointers are bound directly to the real ICU symbols instead of being looked
+// up with dlsym().  Exactly one ICU version ships in the binary, so the
+// requested version is ignored and a singleton is returned.
+namespace {
+
+/**
+ * ucol_getContractionsAndExpansions with the return type Firebird declares.
+ *
+ * The engine ignores the result; the type exists only so the indirect call
+ * through the ICU function table type-checks under WebAssembly.
+ */
+int32_t U_EXPORT2 wasmUcolGetContractionsAndExpansions(const UCollator* coll,
+	USet* contractions, USet* expansions, UBool addPrefixes, UErrorCode* status)
+{
+	ucol_getContractionsAndExpansions(coll, contractions, expansions, addPrefixes, status);
+	return 0;
+}
+
+} // namespace
+
+UnicodeUtil::ICU* UnicodeUtil::loadICU(const Firebird::string& /*icuVersion*/,
+	const Firebird::string& /*configInfo*/)
+{
+	static ICU* wasmIcu = nullptr;
+	if (wasmIcu)
+		return wasmIcu;
+
+	wasmIcu = FB_NEW_POOL(*getDefaultMemoryPool()) ICU(
+		U_ICU_VERSION_MAJOR_NUM, U_ICU_VERSION_MINOR_NUM);
+
+	// No dynamic module loading: inModule and ucModule stay NULL, which the
+	// destructor handles safely.
+
+	// common library (libicuuc)
+	// ICU takes const uint8_t*; the struct field predates that.
+	wasmIcu->uVersionToString = reinterpret_cast<decltype(wasmIcu->uVersionToString)>(u_versionToString);
+	wasmIcu->ulocCountAvailable = uloc_countAvailable;
+	wasmIcu->ulocGetAvailable   = uloc_getAvailable;
+	wasmIcu->usetClose          = uset_close;
+	wasmIcu->usetGetItem        = uset_getItem;
+	wasmIcu->usetGetItemCount   = uset_getItemCount;
+	wasmIcu->usetOpen           = uset_open;
+
+	// i18n library (libicui18n)
+	wasmIcu->ucolClose                        = ucol_close;
+	// ICU returns void here and the struct field declares int32_t.  A cast
+	// makes that link, and traps on WebAssembly: a function's type includes
+	// its return type, and indirect calls are type-checked, so calling a void
+	// function through an int32_t-returning pointer aborts with "null function
+	// or function signature mismatch".  Native builds get away with it by
+	// reading a return register nobody looks at.  Forward through a wrapper of
+	// the declared shape instead.
+	wasmIcu->ucolGetContractionsAndExpansions = wasmUcolGetContractionsAndExpansions;
+	wasmIcu->ucolGetRules                     = ucol_getRules;
+	wasmIcu->ucolGetSortKey                   = ucol_getSortKey;
+	wasmIcu->ucolOpen                         = ucol_open;
+	wasmIcu->ucolOpenRules                    = ucol_openRules;
+	wasmIcu->ucolSetAttribute                 = ucol_setAttribute;
+	wasmIcu->ucolStrColl                      = ucol_strcoll;
+	wasmIcu->ucolGetVersion                   = ucol_getVersion;
+	wasmIcu->utransOpenU                      = utrans_openU;
+	wasmIcu->utransClose                      = utrans_close;
+	wasmIcu->utransTransUChars                = utrans_transUChars;
+
+	UErrorCode status = U_ZERO_ERROR;
+	UCollator* collator = wasmIcu->ucolOpen("", &status);
+	if (collator)
+	{
+		wasmIcu->ucolGetVersion(collator, wasmIcu->collVersion);
+		wasmIcu->ucolClose(collator);
+	}
+
+	return wasmIcu;
+}
+#else
 UnicodeUtil::ICU* UnicodeUtil::loadICU(const string& icuVersion, const string& configInfo)
 {
 	ObjectsArray<string> versions;
@@ -1270,6 +1356,7 @@ UnicodeUtil::ICU* UnicodeUtil::loadICU(const string& icuVersion, const string& c
 
 	return NULL;
 }
+#endif // !__EMSCRIPTEN__
 
 
 void UnicodeUtil::getICUVersion(ICU* icu, int& majorVersion, int& minorVersion) noexcept
@@ -1281,6 +1368,46 @@ void UnicodeUtil::getICUVersion(ICU* icu, int& majorVersion, int& minorVersion)
 
 UnicodeUtil::ConversionICU& UnicodeUtil::getConversionICU()
 {
+#ifdef __EMSCRIPTEN__
+	// Statically linked ICU: populate ConversionICU with the real symbols.
+	static ConversionICU wasmConv = {};
+	if (!wasmConv.ucnv_open)
+	{
+		wasmConv.ucnv_open             = ucnv_open;
+		wasmConv.ucnv_close            = ucnv_close;
+		wasmConv.ucnv_fromUChars       = ucnv_fromUChars;
+		wasmConv.u_tolower             = u_tolower;
+		wasmConv.u_toupper             = u_toupper;
+		wasmConv.u_strCompare          = u_strCompare;
+		wasmConv.u_countChar32         = u_countChar32;
+		wasmConv.utf8_nextCharSafeBody = utf8_nextCharSafeBody;
+		wasmConv.UCNV_TO_U_CALLBACK_STOP = UCNV_TO_U_CALLBACK_STOP;
+		wasmConv.ucnv_setToUCallBack   = ucnv_setToUCallBack;
+		wasmConv.ucnv_setFromUCallBack = ucnv_setFromUCallBack;
+		wasmConv.ucnv_fromUnicode      = ucnv_fromUnicode;
+		wasmConv.ucnv_toUnicode        = ucnv_toUnicode;
+		wasmConv.ucnv_getInvalidChars  = ucnv_getInvalidChars;
+		wasmConv.ucnv_getMaxCharSize   = ucnv_getMaxCharSize;
+		wasmConv.ucnv_getMinCharSize   = ucnv_getMinCharSize;
+		wasmConv.ustrcmp               = u_strcmp;
+
+		wasmConv.ucalGetTZDataVersion          = ucal_getTZDataVersion;
+		wasmConv.ucalGetDefaultTimeZone        = ucal_getDefaultTimeZone;
+		wasmConv.ucalOpen                      = ucal_open;
+		wasmConv.ucalClose                     = ucal_close;
+		wasmConv.ucalSetAttribute              = ucal_setAttribute;
+		wasmConv.ucalSetMillis                 = ucal_setMillis;
+		// ICU takes const UCalendar*; the struct field does not.
+		wasmConv.ucalGet = reinterpret_cast<decltype(wasmConv.ucalGet)>(ucal_get);
+		wasmConv.ucalSetDateTime               = ucal_setDateTime;
+		wasmConv.ucalGetNow                    = ucal_getNow;
+		wasmConv.ucalGetTimeZoneTransitionDate = ucal_getTimeZoneTransitionDate;
+
+		wasmConv.vMajor = U_ICU_VERSION_MAJOR_NUM;
+		wasmConv.vMinor = U_ICU_VERSION_MINOR_NUM;
+	}
+	return wasmConv;
+#else
 	if (convIcu)
 	{
 		return *convIcu;
@@ -1375,6 +1502,7 @@ UnicodeUtil::ConversionICU& UnicodeUtil::getConversionICU()
 
 	// compiler warning silencer
 	return *convIcu;
+#endif // !__EMSCRIPTEN__
 }
 
 
