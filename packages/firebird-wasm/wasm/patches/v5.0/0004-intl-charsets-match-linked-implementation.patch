From: electric-firebird
Subject: [PATCH] IntlManager: charset tables that match what is linked in (Firebird 5.0)

Firebird 5.0 (v5.0-release) counterpart of
0004-intl-charsets-match-linked-implementation.patch, where defaultCollations
uses integer collation IDs rather than CollId(...) and sentinel {0, 0, NULL, ...}.

diff --git a/src/jrd/IntlManager.cpp b/src/jrd/IntlManager.cpp
index 765038b..e99f270 100644
--- a/src/jrd/IntlManager.cpp
+++ b/src/jrd/IntlManager.cpp
@@ -101,6 +101,12 @@ static GlobalPtr<ModulesMap> modules;
 static GlobalPtr<GenericMap<Pair<Full<string, ExternalInfo> > > > charSetCollations;
 
 
+// Four of the character sets above are not implemented by the intl module's
+// own tables: LD_lookup_charset() falls through to CSICU_charset_init(), i.e.
+// an ICU converter.  This build's static ICU does not carry their converter
+// data, so instantiating them during CREATE DATABASE fails with
+// "CHARACTER SET ... is not installed".  The other 43 are table-driven and
+// work.
 const IntlManager::CharSetDefinition IntlManager::defaultCharSets[] =
 {
 	{"NONE", CS_NONE, 1},
@@ -112,6 +118,7 @@ const IntlManager::CharSetDefinition IntlManager::defaultCharSets[] =
 	{"UTF16", CS_UTF16, 4},
 	{"UTF32", CS_UTF32, 4},
 #endif	// FB_NEW_INTL_NOT_READY
+#if !defined(__EMSCRIPTEN__) || defined(FB_WASM_STATIC_INTL)
 	{"SJIS_0208", CS_SJIS, 2},
 	{"EUCJ_0208", CS_EUCJ, 2},
 	{"DOS437", CS_DOS_437, 1},
@@ -155,10 +162,19 @@ const IntlManager::CharSetDefinition IntlManager::defaultCharSets[] =
 	{"KOI8R", CS_KOI8R, 1},
 	{"KOI8U", CS_KOI8U, 1},
 	{"WIN1258", CS_WIN1258, 1},
+#ifndef FB_WASM_STATIC_INTL
 	{"TIS620", CS_TIS620, 1},
+#endif
+#ifndef FB_WASM_STATIC_INTL
 	{"GBK", CS_GBK, 2},
+#endif
+#ifndef FB_WASM_STATIC_INTL
 	{"CP943C", CS_CP943C, 2},
+#endif
+#ifndef FB_WASM_STATIC_INTL
 	{"GB18030", CS_GB18030, 4},
+#endif
+#endif // !__EMSCRIPTEN__
 	{NULL, 0, 0}
 };
 
@@ -258,6 +274,7 @@ const IntlManager::CollationDefinition IntlManager::defaultCollations[] =
 	{CS_UTF32, 0, "UTF32", NULL, TEXTTYPE_ATTR_PAD_SPACE, NULL},
 	{CS_UTF32, 1, "UCS_BASIC", NULL, TEXTTYPE_ATTR_PAD_SPACE, NULL},
 #endif	// FB_NEW_INTL_NOT_READY
+#if !defined(__EMSCRIPTEN__) || defined(FB_WASM_STATIC_INTL)
 	{CS_SJIS, 0, "SJIS_0208", NULL, TEXTTYPE_ATTR_PAD_SPACE, NULL},
 	{CS_EUCJ, 0, "EUCJ_0208", NULL, TEXTTYPE_ATTR_PAD_SPACE, NULL},
 	{CS_DOS_437, 0, "DOS437", NULL, TEXTTYPE_ATTR_PAD_SPACE, NULL},
@@ -402,14 +419,31 @@ const IntlManager::CollationDefinition IntlManager::defaultCollations[] =
 	{CS_KOI8U, 0, "KOI8U", NULL, TEXTTYPE_ATTR_PAD_SPACE, NULL},
 	{CS_KOI8U, 1, "KOI8U_UA", NULL, TEXTTYPE_ATTR_PAD_SPACE, NULL},
 	{CS_WIN1258, 0, "WIN1258", NULL, TEXTTYPE_ATTR_PAD_SPACE, NULL},
+#ifndef FB_WASM_STATIC_INTL
 	{CS_TIS620, 0, "TIS620", NULL, TEXTTYPE_ATTR_PAD_SPACE, NULL},
+#endif
+#ifndef FB_WASM_STATIC_INTL
 	{CS_TIS620, 1, "TIS620_UNICODE", NULL, TEXTTYPE_ATTR_PAD_SPACE, NULL},
+#endif
+#ifndef FB_WASM_STATIC_INTL
 	{CS_GBK, 0, "GBK", NULL, TEXTTYPE_ATTR_PAD_SPACE, NULL},
+#endif
+#ifndef FB_WASM_STATIC_INTL
 	{CS_GBK, 1, "GBK_UNICODE", NULL, TEXTTYPE_ATTR_PAD_SPACE, NULL},
+#endif
+#ifndef FB_WASM_STATIC_INTL
 	{CS_CP943C, 0, "CP943C", NULL, TEXTTYPE_ATTR_PAD_SPACE, NULL},
+#endif
+#ifndef FB_WASM_STATIC_INTL
 	{CS_CP943C, 1, "CP943C_UNICODE", NULL, TEXTTYPE_ATTR_PAD_SPACE, NULL},
+#endif
+#ifndef FB_WASM_STATIC_INTL
 	{CS_GB18030, 0, "GB18030", NULL, TEXTTYPE_ATTR_PAD_SPACE, NULL},
+#endif
+#ifndef FB_WASM_STATIC_INTL
 	{CS_GB18030, 1, "GB18030_UNICODE", NULL, TEXTTYPE_ATTR_PAD_SPACE, NULL},
+#endif
+#endif // !__EMSCRIPTEN__
 	{0, 0, NULL, NULL, 0, NULL}
 };
 
