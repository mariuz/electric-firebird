# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Test artifacts
coverage/
playwright-report/
playwright-report-wasm/
test-results/

# Firebird database files
*.fdb
*.fdb-journal

# WASM build artifacts
# build-* covers the debug/sanitizer trees (build-asan, build-emu, …) as well
# as the default one, so a new variant does not get committed by accident.
packages/firebird-wasm/wasm/build*/
*.wasm

# Misc
.DS_Store
*.log

# ICU data packages are generated from the Emscripten port's download
# cache by wasm/tools/build-icu-data.sh; 800 KB to 27 MB, not source.
packages/firebird-wasm/wasm/icu-data/*.dat
